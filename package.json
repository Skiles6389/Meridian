{
  "name": "dogfight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8731 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 8731 --strictPort",
    "test": "vitest run",
    "sim": "tsc --noEmit -p tools/sim && esbuild tools/sim/cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dogfight-sim/cli.mjs --log-level=warning && node node_modules/.cache/dogfight-sim/cli.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.0.5"
  }
}
